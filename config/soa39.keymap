/*
 * SOA39 keymap
 *
 * Base-layer custom keys:
 *   Q hold = Ctrl     W hold = Win     P hold = Shift
 *   E double-tap = Esc
 *   R double-tap = Tab
 *   J double-tap = Japanese input (LANGUAGE_1)
 *   H double-tap = English input (LANGUAGE_2)
 *
 * Layer numbers intentionally follow the SOA44 source keymap:
 *   0 Default, 1 Mouse, 2 Function, 3 Num, 4 Arrow, 5 Scroll, 6 Bluetooth
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    behaviors {
        /* Single tap sends the letter; double tap sends the alternate key. */
        td_e: tap_dance_e {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp E>, <&kp ESCAPE>;
        };

        td_r: tap_dance_r {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp R>, <&kp TAB>;
        };

        td_j: tap_dance_j {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp J>, <&kp LANGUAGE_1>;
        };

        td_h: tap_dance_h {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp H>, <&kp LANGUAGE_2>;
        };

    };

    combos {
        compatible = "zmk,combos";

        /* Retained from the existing SOA39 keymap: positions are SOA39 positions. */
        tab {
            bindings = <&kp TAB>;
            key-positions = <9 10>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <10 11>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <9 8>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <18 19>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <22 23>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&mt LEFT_CONTROL Q  &mt LEFT_WIN W  &td_e  &td_r  &kp T      &kp Y             &kp U   &kp I   &kp O     &mt LEFT_SHIFT P
&kp A               &kp S           &kp D   &kp F  &kp G      &td_h             &td_j   &kp K   &kp L     &lt 5 MINUS
&mt LEFT_SHIFT Z     &mt LEFT_ALT X  &kp C   &kp V  &kp B      &kp SLASH         &kp N   &kp M   &kp COMMA &mt RIGHT_SHIFT PERIOD
&kp LEFT_SHIFT      &mt LCTRL TAB   &lt 6 DELETE  &lt 2 SPACE  &lt 5 LANGUAGE_2  &lt 3 BACKSPACE  &lt 4 ENTER  &kp LEFT_ALT  &lt 6 EQUAL
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans
            >;
        };

        FUNCTION {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp CARET       &kp AMPERSAND     &kp ASTERISK       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp F1           &kp F2       &kp F3    &kp F4      &kp F5       &kp BACKSPACE   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SQT               &kp UNDERSCORE
&kp F6           &kp F7       &kp F8    &kp F9      &kp F10      &kp PLUS        &kp MINUS         &kp ASTRK          &kp SLASH             &kp DOUBLE_QUOTES
&trans           &kp F11      &kp F12   &trans      &trans       &kp LANGUAGE_1  &kp LANGUAGE_2    &trans             &trans
            >;
        };

        NUM {
            bindings = <
&kp N1            &kp N2             &kp N3          &kp N4           &kp N5         &kp N6         &kp N7  &kp N8  &kp N9  &kp N0
&trans            &trans             &trans          &trans           &kp BACKSLASH  &kp BACKSPACE  &kp N4  &kp N5  &kp N6  &kp MINUS
&kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp PIPE       &kp BACKSLASH  &kp N0  &kp N1  &kp N2  &kp N3
&trans            &trans             &trans          &trans           &trans         &trans         &trans  &kp PERIOD  &kp SLASH
            >;
        };

        ARROW {
            bindings = <
&kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7          &kp N8          &kp N9        &kp N0
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp LEFT  &kp DOWN        &kp UP_ARROW  &kp RIGHT  &kp UNDERSCORE
&kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp LANGUAGE_1  &kp LANGUAGE_2  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans   &trans   &trans          &trans          &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        Bluetooth {
            bindings = <
&trans        &trans        &trans        &trans       &trans       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans
&trans        &trans        &trans        &trans       &trans       &trans        &trans        &trans        &trans        &trans
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans       &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans       &trans       &trans        &trans        &bt BT_CLR_ALL  &trans
            >;
        };
    };
};
